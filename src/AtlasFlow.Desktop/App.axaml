<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtlasFlow.Desktop.App"
             RequestedThemeVariant="Dark">

  <!--
    Dark is the product's quiet-workspace default. The shell keeps an explicit
    accessible toggle, and persistence will move to the local settings adapter.
  -->

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/AtlasTheme.axaml" />
  </Application.Styles>

</Application>
