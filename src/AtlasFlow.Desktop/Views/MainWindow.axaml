<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        xmlns:viewModels="clr-namespace:AtlasFlow.Desktop.ViewModels"
        xmlns:discuss="clr-namespace:AtlasFlow.Domain.Discuss;assembly=AtlasFlow.Domain"
        xmlns:execution="clr-namespace:AtlasFlow.Domain.Execution;assembly=AtlasFlow.Domain"
        xmlns:planning="clr-namespace:AtlasFlow.Domain.Planning;assembly=AtlasFlow.Domain"
        x:Class="AtlasFlow.Desktop.Views.MainWindow"
        x:DataType="viewModels:WorkspaceViewModel"
        Title="Atlas Flow"
        Width="1440"
        Height="900"
        MinWidth="960"
        MinHeight="640">

  <Grid RowDefinitions="50,*,30">
    <Border Grid.Row="0"
            Background="{DynamicResource AtlasDeepSurfaceBrush}"
            BorderBrush="{DynamicResource AtlasBorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="28"
                  Height="28"
                  CornerRadius="8"
                  Background="{DynamicResource AtlasAccentBrush}">
            <TextBlock Text="A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AtlasOnAccentBrush}" />
          </Border>

          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="ATLAS FLOW" Classes="eyebrow" />
            <TextBlock Text="{Binding ProjectName}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>

          <Border Width="1"
                  Height="24"
                  Margin="4,0"
                  Background="{DynamicResource AtlasBorderBrush}" />

          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedStage.Title}" FontSize="12" />
            <TextBlock Text="{Binding ProjectPath}" Classes="micro" MaxWidth="360" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="atlas-button ghost"
                  IsEnabled="False"
                  a11y:AutomationProperties.Name="Abrir paleta de comandos">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Comandos" />
              <Border Padding="5,2"
                      CornerRadius="4"
                      BorderBrush="{DynamicResource AtlasBorderBrush}"
                      BorderThickness="1">
                <TextBlock Text="Ctrl K" Classes="mono micro" />
              </Border>
            </StackPanel>
            <ToolTip.Tip>Disponível quando os comandos de aplicação forem conectados.</ToolTip.Tip>
          </Button>

          <Button Classes="atlas-button"
                  Command="{Binding ToggleThemeCommand}"
                  a11y:AutomationProperties.Name="Alternar tema claro ou escuro">
            <TextBlock Text="{Binding ThemeModeLabel}" />
          </Button>

          <Button Classes="atlas-button"
                  Command="{Binding ToggleContextCommand}"
                  a11y:AutomationProperties.Name="Mostrar ou ocultar painel de contexto">
            <TextBlock Text="Contexto" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0"
              Width="{Binding NavigationPanelWidth}"
              ClipToBounds="True"
              Background="{DynamicResource AtlasDeepSurfaceBrush}"
              BorderBrush="{DynamicResource AtlasBorderSubtleBrush}"
              BorderThickness="0,0,1,0"
              Padding="8,12">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,12">
            <TextBlock Text="FLOW" Classes="eyebrow" VerticalAlignment="Center" />
            <Button x:Name="ToggleNavigationButton"
                    Grid.Column="1"
                    Classes="atlas-button icon ghost"
                    Command="{Binding ToggleNavigationCommand}"
                    a11y:AutomationProperties.Name="Expandir ou recolher navegação">
              <TextBlock Text="≡" FontSize="16" />
            </Button>
          </Grid>

          <ListBox x:Name="StageNavigation"
                   Grid.Row="1"
                   Classes="stage-list"
                   ItemsSource="{Binding Stages}"
                   SelectedItem="{Binding SelectedStage}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="viewModels:WorkspaceStageViewModel">
                <Grid ColumnDefinitions="16,*" Height="36" ToolTip.Tip="{Binding Description}">
                  <Grid Width="6" Height="6" VerticalAlignment="Center">
                    <Border CornerRadius="3"
                            IsVisible="{Binding IsEnabled}"
                            Background="{DynamicResource AtlasAccentBrush}" />
                    <Border CornerRadius="3"
                            IsVisible="{Binding !IsEnabled}"
                            Background="{DynamicResource AtlasDisabledTextBrush}" />
                  </Grid>
                  <StackPanel Grid.Column="1"
                              Margin="10,0,0,0"
                              Orientation="Horizontal"
                              Spacing="8"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AvailabilityLabel}" Classes="micro" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="3" Classes="panel" Padding="12" Margin="0,12,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="PROJECT TRUTH" Classes="eyebrow" />
              <TextBlock Text="{Binding GoalSummaryLabel}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="Git e Project Atlas continuam canônicos." Classes="micro" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource AtlasBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24" Spacing="20">
            <Border Classes="panel" Padding="14">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AtlasWarningBrush}" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding ProjectModeLabel}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ProjectModeDescription}" Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding SelectedStage.Kicker}" Classes="eyebrow" />
                <TextBlock Text="{Binding SelectedStage.Title}" Classes="heading" />
                <TextBlock Text="{Binding SelectedStage.Description}"
                           Classes="secondary"
                           MaxWidth="720"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Button Grid.Column="1"
                      Classes="atlas-button primary"
                      IsEnabled="False"
                      a11y:AutomationProperties.Name="Executar próxima ação do estágio">
                <TextBlock Text="{Binding SelectedStage.NextAction}" />
                <ToolTip.Tip>A ação será habilitada pelo gateway de aplicação.</ToolTip.Tip>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
              <Border Classes="panel"
                      Padding="20"
                      IsVisible="{Binding IsDefineStageSelected}">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Conversa de definição" Classes="section-heading" />
                      <TextBlock Text="Transforme intenção em decisões sem perder o vínculo com a verdade do projeto."
                                 Classes="muted"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="DISCUSS" Classes="eyebrow" />
                  </Grid>

                  <Border Grid.Row="1" Classes="elevated-panel" Padding="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Discuss.IntegrationStatusLabel}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Discuss.DiscussionStateLabel}" Classes="micro" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="atlas-button"
                              Command="{Binding Discuss.StartDiscussionCommand}"
                              IsEnabled="{Binding Discuss.CanStartDiscussion}"
                              a11y:AutomationProperties.Name="Iniciar nova conversa">
                        Nova conversa
                      </Button>
                    </Grid>
                  </Border>

                  <Border Grid.Row="2"
                          Classes="elevated-panel"
                          Padding="14"
                          IsVisible="{Binding Discuss.IsEmptyState}">
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                      <TextBlock Text="Nenhuma conversa carregada"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Discuss.DiscussionSummaryLabel}"
                                 Classes="secondary"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 MaxWidth="520" />
                      <TextBlock Text="O serviço de Discuss ainda não está registrado neste runtime."
                                 Classes="micro"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 IsVisible="{Binding Discuss.IsServiceUnavailable}" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="2"
                          Classes="elevated-panel"
                          Padding="12"
                          IsVisible="{Binding Discuss.HasDiscussion}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Discuss.DiscussionSummaryLabel}"
                                   Classes="micro"
                                   Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding Discuss.Messages}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="discuss:DiscussionMessage">
                              <Border Classes="panel" Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="6">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TurnType}"
                                               Classes="mono micro" />
                                  </Grid>
                                  <TextBlock Text="{Binding Content}"
                                             TextWrapping="Wrap"
                                             Classes="secondary" />
                                  <ItemsControl ItemsSource="{Binding References}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="discuss:MessageReference">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                          <TextBlock Text="↳" Classes="micro" />
                                          <TextBlock Grid.Column="1"
                                                     Text="{Binding Label}"
                                                     Classes="micro"
                                                     ToolTip.Tip="{Binding Path.Value}" />
                                        </Grid>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>

                  <Grid Grid.Row="3"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="8"
                        IsVisible="{Binding Discuss.HasDiscussion}">
                    <TextBox Text="{Binding Discuss.DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                             Classes="atlas-input"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="76"
                             PlaceholderText="Escreva a intenção, restrição ou pergunta..."
                             a11y:AutomationProperties.Name="Mensagem da conversa" />

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding Discuss.ReferencePath, UpdateSourceTrigger=PropertyChanged}"
                               Classes="atlas-input"
                               PlaceholderText="Caminho relativo no projeto, por exemplo docs/ATLAS.md"
                               a11y:AutomationProperties.Name="Caminho da referência no projeto" />
                      <Button Grid.Column="1"
                              Classes="atlas-button"
                              Command="{Binding Discuss.AddFileCommand}"
                              IsEnabled="{Binding Discuss.CanAddReference}"
                              a11y:AutomationProperties.Name="Adicionar referência de arquivo">
                        Arquivo
                      </Button>
                      <Button Grid.Column="2"
                              Classes="atlas-button"
                              Command="{Binding Discuss.AddImageCommand}"
                              IsEnabled="{Binding Discuss.CanAddReference}"
                              a11y:AutomationProperties.Name="Adicionar referência de imagem">
                        Imagem
                      </Button>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Discuss.ReferenceSummaryLabel}" Classes="micro" />
                          <Button Classes="atlas-button ghost"
                                  Command="{Binding Discuss.ClearReferencesCommand}"
                                  IsEnabled="{Binding Discuss.HasReferences}"
                                  a11y:AutomationProperties.Name="Limpar referências da mensagem">
                            Limpar
                          </Button>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Discuss.References}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="discuss:MessageReference">
                              <TextBlock Text="{Binding Path.Value, StringFormat='↳ {0}'}"
                                         Classes="micro"
                                         TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Discuss.ComposerStatusLabel}"
                                 Classes="micro"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="2"
                              Classes="atlas-button primary"
                              Command="{Binding Discuss.SendCommand}"
                              IsEnabled="{Binding Discuss.CanSendMessage}"
                              a11y:AutomationProperties.Name="Enviar mensagem da conversa">
                        Enviar
                      </Button>
                    </Grid>
                  </Grid>

                  <Border Grid.Row="4"
                          IsVisible="{Binding Discuss.HasError}"
                          Classes="panel"
                          Padding="10"
                          BorderBrush="{DynamicResource AtlasDangerBrush}">
                    <TextBlock Text="{Binding Discuss.ErrorMessage}"
                               Foreground="{DynamicResource AtlasDangerBrush}"
                               TextWrapping="Wrap" />
                  </Border>
                </Grid>
              </Border>

              <Border Classes="panel" Padding="20" MinHeight="300" IsVisible="{Binding IsPrimarySurfaceVisible}">
                <StackPanel Spacing="20">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Superfície principal" Classes="section-heading" />
                      <TextBlock Text="Uma atividade por vez, com contexto persistente ao redor." Classes="muted" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="FRONTEND" Classes="eyebrow" />
                  </Grid>

                  <Border Classes="elevated-panel" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="34"
                              Height="34"
                              CornerRadius="8"
                              Background="{DynamicResource AtlasAccentSoftBrush}">
                        <TextBlock Text="01"
                                   Classes="mono"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AtlasAccentBrush}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Renderer desacoplado" FontWeight="SemiBold" />
                        <TextBlock Text="Views e ViewModels consomem apenas contratos públicos agregados no gateway."
                                   Classes="secondary"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Classes="elevated-panel" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="34"
                              Height="34"
                              CornerRadius="8"
                              Background="{DynamicResource AtlasAccentSoftBrush}">
                        <TextBlock Text="02"
                                   Classes="mono"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AtlasAccentBrush}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Comandos por intenção" FontWeight="SemiBold" />
                        <TextBlock Text="A UI solicitará ações; o núcleo validará e produzirá eventos tipados."
                                   Classes="secondary"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Classes="elevated-panel" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <Border Width="34"
                              Height="34"
                              CornerRadius="8"
                              Background="{DynamicResource AtlasAccentSoftBrush}">
                        <TextBlock Text="03"
                                   Classes="mono"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AtlasAccentBrush}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Estado recuperável" FontWeight="SemiBold" />
                        <TextBlock Text="Eventos atualizam a projeção; Git e SQLite permanecem fora do renderer."
                                   Classes="secondary"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="0"
                      Classes="panel"
                      Padding="20"
                      IsVisible="{Binding IsPlanStageSelected}">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Plano executável" Classes="section-heading" />
                      <TextBlock Text="Revise o snapshot antes de bloqueá-lo para execução." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="PLAN" Classes="eyebrow" />
                  </Grid>

                  <Border Classes="elevated-panel" Padding="14">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Plan.GoalTitle}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Plan.GoalObjective}" Classes="secondary" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Plan.SelectedPlanSummary}" Classes="micro" />
                    </StackPanel>
                  </Border>

                  <Border IsVisible="{Binding Plan.HasPlans}"
                          Classes="elevated-panel"
                          Padding="14">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Decisão de contexto" Classes="eyebrow" />
                      <TextBlock Text="{Binding Plan.SelectedContextState}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Plan.SelectedContextSummary}"
                                 Classes="secondary"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Plan.SelectedContextReasons}"
                                 Classes="micro"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Plan.SelectedPlanState}"
                               Classes="mono"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="atlas-button"
                            Command="{Binding Plan.CreatePlanCommand}"
                            IsEnabled="{Binding Plan.CanCreatePlan}"
                            a11y:AutomationProperties.Name="Criar snapshot de plano">
                      Criar rascunho
                    </Button>
                    <Button Grid.Column="2"
                            Classes="atlas-button primary"
                            Command="{Binding Plan.LockPlanCommand}"
                            IsEnabled="{Binding Plan.CanLockPlan}"
                            a11y:AutomationProperties.Name="Bloquear plano selecionado">
                      Bloquear plano
                    </Button>
                    <Button Grid.Column="3"
                            Classes="atlas-button primary"
                            Command="{Binding Run.StartRunCommand}"
                            IsEnabled="{Binding Run.CanStartRun}"
                            a11y:AutomationProperties.Name="Executar plano bloqueado">
                      Executar plano
                    </Button>
                  </Grid>

                  <Border IsVisible="{Binding Plan.HasError}"
                          Classes="panel"
                          Padding="10"
                          BorderBrush="{DynamicResource AtlasDangerBrush}">
                    <TextBlock Text="{Binding Plan.ErrorMessage}"
                               Foreground="{DynamicResource AtlasDangerBrush}"
                               TextWrapping="Wrap" />
                  </Border>

                  <ListBox ItemsSource="{Binding Plan.Plans}"
                           SelectedItem="{Binding Plan.SelectedPlan}"
                           a11y:AutomationProperties.Name="Snapshots de plano">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="planning:Plan">
                        <Border Classes="elevated-panel" Padding="10" Margin="0,0,0,6">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Tasks.Count, StringFormat='{}{0} tarefa(s)'}" Classes="micro" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Runner}" Classes="mono micro" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Border IsVisible="{Binding Plan.HasPlans}"
                          Classes="elevated-panel"
                          Padding="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Tarefas do snapshot selecionado" Classes="eyebrow" />
                      <ItemsControl ItemsSource="{Binding Plan.SelectedPlan.Tasks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="planning:PlanTask">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,4">
                              <Border Width="24"
                                      Height="24"
                                      CornerRadius="6"
                                      Background="{DynamicResource AtlasAccentSoftBrush}">
                                <TextBlock Text="·"
                                           Foreground="{DynamicResource AtlasAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Objective}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Risk}"
                                           Classes="micro"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="0"
                      Classes="panel"
                      Padding="20"
                      IsVisible="{Binding IsRunStageSelected}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Command center de execução" Classes="section-heading" />
                      <TextBlock Text="Acompanhe o estado durável; a atividade chega pelo stream do run." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="RUN" Classes="eyebrow" />
                  </Grid>

                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Run.SelectedRunState}" Classes="mono" />
                      <TextBlock Text="{Binding Run.SelectedRunSummary}" Classes="micro" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Run.TaskProgress}" Classes="secondary" VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Classes="atlas-button"
                            Command="{Binding Run.CancelRunCommand}"
                            IsEnabled="{Binding Run.CanCancelRun}"
                            a11y:AutomationProperties.Name="Solicitar cancelamento da execução">
                      Cancelar
                    </Button>
                  </Grid>

                  <Grid Grid.Row="2" ColumnDefinitions="*,1.35*" ColumnSpacing="12">
                    <Border Classes="elevated-panel" Padding="12">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Fila de runs" Classes="eyebrow" />
                          <TextBlock Grid.Column="1" Text="{Binding Run.StreamStatus}" Classes="micro" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Run.Runs}"
                                 SelectedItem="{Binding Run.SelectedRun}"
                                 a11y:AutomationProperties.Name="Fila de execuções">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="execution:Run">
                              <Border Classes="panel" Padding="10" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                  <Border Width="7"
                                          Height="7"
                                          CornerRadius="4"
                                          VerticalAlignment="Center"
                                          Background="{DynamicResource AtlasAccentBrush}" />
                                  <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GoalId}" Classes="micro" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Text="{Binding Id}" Classes="mono micro" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="elevated-panel" Padding="12">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Timeline semântica" Classes="eyebrow" />
                          <TextBlock Grid.Column="1" Text="{Binding Run.TaskProgress}" Classes="micro" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding Run.Events}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="execution:DomainEvent">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,4">
                                  <Border Width="7"
                                          Height="7"
                                          CornerRadius="4"
                                          VerticalAlignment="Center"
                                          Background="{DynamicResource AtlasInfoBrush}" />
                                  <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Type}" Classes="micro" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2"
                                             Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                             Classes="mono micro"
                                             VerticalAlignment="Center" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2"
                                   Text="Eventos duráveis · replay + live"
                                   Classes="micro"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </Grid>

                  <Border Grid.Row="3" IsVisible="{Binding Run.HasError}" Classes="panel" Padding="10" BorderBrush="{DynamicResource AtlasDangerBrush}">
                    <TextBlock Text="{Binding Run.ErrorMessage}" Foreground="{DynamicResource AtlasDangerBrush}" TextWrapping="Wrap" />
                  </Border>
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Spacing="16">
                <Border Classes="panel"
                        Padding="16"
                        IsVisible="{Binding IsDefineStageSelected}">
                  <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Decision Rail" Classes="section-heading" />
                        <TextBlock Text="{Binding Discuss.DecisionSummaryLabel}"
                                   Classes="micro"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="DECISIONS" Classes="eyebrow" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                      <ListBox ItemsSource="{Binding Discuss.Decisions}"
                               SelectedItem="{Binding Discuss.SelectedDecision}"
                               IsVisible="{Binding Discuss.HasDecisions}"
                               a11y:AutomationProperties.Name="Decisões da conversa">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="discuss:Decision">
                            <Border Classes="elevated-panel" Padding="10" Margin="0,0,0,6">
                              <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <TextBlock Text="{Binding Title}"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding State}"
                                             Classes="mono micro" />
                                </Grid>
                                <TextBlock Text="{Binding Statement}"
                                           Classes="secondary"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <Border Classes="elevated-panel"
                              Padding="10"
                              IsVisible="{Binding Discuss.IsDecisionEmptyState}">
                        <TextBlock Text="Nenhuma decisão proposta. Registre uma decisão quando a conversa tiver uma escolha revisável."
                                   Classes="micro"
                                   TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Classes="atlas-button ghost"
                            Command="{Binding Discuss.ToggleDecisionFormCommand}"
                            HorizontalAlignment="Left"
                            a11y:AutomationProperties.Name="Mostrar ou ocultar formulário de proposta de decisão">
                      <TextBlock Text="{Binding Discuss.DecisionFormToggleLabel}" />
                    </Button>

                    <Border Grid.Row="3"
                            Classes="elevated-panel"
                            Padding="10"
                            IsVisible="{Binding Discuss.IsDecisionFormVisible}">
                      <StackPanel Spacing="8">
                        <TextBox Text="{Binding Discuss.DecisionTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="atlas-input"
                                 PlaceholderText="Título curto da decisão"
                                 a11y:AutomationProperties.Name="Título da decisão" />
                        <TextBox Text="{Binding Discuss.DecisionStatement, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="atlas-input"
                                 PlaceholderText="O que foi decidido?"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="54"
                                 a11y:AutomationProperties.Name="Enunciado da decisão" />
                        <TextBox Text="{Binding Discuss.DecisionRationale, UpdateSourceTrigger=PropertyChanged}"
                                 Classes="atlas-input"
                                 PlaceholderText="Por que esta decisão é necessária?"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="54"
                                 a11y:AutomationProperties.Name="Justificativa da decisão" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBlock Text="{Binding Discuss.SelectedDecisionSummary}"
                                     Classes="micro"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center" />
                          <Button Grid.Column="1"
                                  Classes="atlas-button"
                                  Command="{Binding Discuss.AcceptCommand}"
                                  IsEnabled="{Binding Discuss.CanAcceptDecision}"
                                  a11y:AutomationProperties.Name="Aceitar decisão selecionada">
                            Aceitar
                          </Button>
                          <Button Grid.Column="2"
                                  Classes="atlas-button primary"
                                  Command="{Binding Discuss.ProposeCommand}"
                                  IsEnabled="{Binding Discuss.CanProposeDecision}"
                                  a11y:AutomationProperties.Name="Propor nova decisão">
                            Propor
                          </Button>
                        </Grid>
                        <Button Classes="atlas-button ghost"
                                Command="{Binding Discuss.FinalizeCommand}"
                                IsEnabled="{Binding Discuss.CanFinalizeDiscussion}"
                                HorizontalAlignment="Left"
                                a11y:AutomationProperties.Name="Finalizar discussão no ledger">
                          Finalizar no ledger
                        </Button>
                        <TextBlock Text="{Binding Discuss.FinalizationStatusLabel}"
                                   Classes="micro"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>

                <Border Classes="panel" Padding="16">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Estado do shell" Classes="section-heading" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Width="7"
                              Height="7"
                              CornerRadius="4"
                              VerticalAlignment="Center"
                              Background="{DynamicResource AtlasSuccessBrush}" />
                      <TextBlock Grid.Column="1" Text="Tokens e composição carregados" Classes="secondary" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Width="7"
                              Height="7"
                              CornerRadius="4"
                              VerticalAlignment="Center"
                              Background="{DynamicResource AtlasWarningBrush}" />
                      <TextBlock Grid.Column="1" Text="Adapter de aplicação conectado" Classes="secondary" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Border Width="7"
                              Height="7"
                              CornerRadius="4"
                              VerticalAlignment="Center"
                              Background="{DynamicResource AtlasWarningBrush}" />
                      <TextBlock Grid.Column="1" Text="Stream AG-UI pendente" Classes="secondary" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="panel" Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Densidade" Classes="eyebrow" />
                    <TextBlock Text="Default" FontWeight="SemiBold" />
                    <TextBlock Text="Compact será reservado para logs, tabelas, árvores e histórico."
                               Classes="micro"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <Border IsVisible="{Binding HasError}"
                    Classes="panel"
                    Padding="14"
                    BorderBrush="{DynamicResource AtlasDangerBrush}">
              <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="{DynamicResource AtlasDangerBrush}"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="ContextPanel"
              Grid.Column="2"
              Width="{Binding ContextPanelWidth}"
              IsVisible="{Binding IsContextVisible}"
              Background="{DynamicResource AtlasDeepSurfaceBrush}"
              BorderBrush="{DynamicResource AtlasBorderSubtleBrush}"
              BorderThickness="1,0,0,0"
              Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="CONTEXTO" Classes="eyebrow" />
              <TextBlock Text="Projeto e integração" Classes="section-heading" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="atlas-button icon ghost"
                    Command="{Binding ToggleContextCommand}"
                    a11y:AutomationProperties.Name="Fechar painel de contexto">
              <TextBlock Text="×" FontSize="18" />
            </Button>
          </Grid>

          <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="12">
            <Border Classes="panel" Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="Fonte de verdade" Classes="eyebrow" />
                <TextBlock Text="Git + Project Atlas" FontWeight="SemiBold" />
                <TextBlock Text="A UI apenas projeta estado e envia intenções tipadas." Classes="micro" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel" Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="Conexão" Classes="eyebrow" />
                <TextBlock Text="{Binding ConnectionDescription}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="O adapter de aplicação está registrado no composition root do Desktop."
                           Classes="micro"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel" Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="PROJECT INTELLIGENCE" Classes="eyebrow" />
                <TextBlock Text="{Binding Plan.IntelligenceStatusLabel}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Plan.IntelligenceSummaryLabel}"
                           Classes="micro"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Plan.IntelligenceCostLabel}"
                           Classes="micro"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel" Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="CONTEXTO PLANEJADO" Classes="eyebrow" />
                <TextBlock Text="{Binding Plan.SelectedContextState}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Plan.SelectedContextSummary}"
                           Classes="micro"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Plan.SelectedContextReasons}"
                           Classes="micro"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel" Padding="14">
              <StackPanel Spacing="8">
                <TextBlock Text="DECISÕES DE DISCUSS" Classes="eyebrow" />
                <TextBlock Text="{Binding Discuss.DecisionSummaryLabel}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="Aceitação e finalização permanecem comandos explícitos do serviço."
                           Classes="micro"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Grid.Row="2" Classes="elevated-panel" Padding="10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBox Classes="atlas-input"
                       IsEnabled="False"
                       PlaceholderText="Pergunte ao Atlas sobre este contexto"
                       a11y:AutomationProperties.Name="Mensagem para o Atlas" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Discuss.ComposerStatusLabel}"
                           Classes="micro"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Classes="atlas-button primary"
                        IsEnabled="False"
                        a11y:AutomationProperties.Name="Enviar mensagem">
                  Enviar
                </Button>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource AtlasDeepSurfaceBrush}"
            BorderBrush="{DynamicResource AtlasBorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="7"
                  Height="7"
                  CornerRadius="4"
                  Background="{DynamicResource AtlasSuccessBrush}" />
          <TextBlock Text="Frontend pronto" Classes="micro" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding ConnectionDescription}"
                   Classes="micro"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Text="Avalonia 12 · .NET 10"
                   Classes="mono micro"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
