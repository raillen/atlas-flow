<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="AtlasFlow.Desktop.Views.MainWindow"
        Title="Atlas Flow"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">

  <!--
    Scaffold only. The workspace shell described in ADR-013 and
    docs/02-ui-ux/INFORMATION_ARCHITECTURE.md has not been ported yet.

    When it is: every interactive control needs an AutomationProperties.Name.
    Avalonia surfaces these through UI Automation on Windows and AT-SPI on
    Linux, which is what replaces the ARIA attributes the React build relied on.
    See docs/02-ui-ux/ACCESSIBILITY.md.
  -->

  <TextBlock Text="Atlas Flow"
             a11y:AutomationProperties.Name="Atlas Flow, not yet implemented"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />

</Window>
